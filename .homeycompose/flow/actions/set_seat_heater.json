{
  "title": {
    "en": "Set seat heater"
  },
  "titleFormatted": {
    "en": "Set [[seat]] seat heater to [[level]]"
  },
  "hint": {
    "en": "Set the heating level for a specific seat"
  },
  "platforms": ["local"],
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=vehicle"
    },
    {
      "type": "dropdown",
      "name": "seat",
      "title": {
        "en": "Seat"
      },
      "values": [
        { "id": "driver", "title": { "en": "Driver" } },
        { "id": "passenger", "title": { "en": "Passenger" } },
        { "id": "rear_left", "title": { "en": "Rear left" } },
        { "id": "rear_center", "title": { "en": "Rear center" } },
        { "id": "rear_right", "title": { "en": "Rear right" } }
      ]
    },
    {
      "type": "dropdown",
      "name": "level",
      "title": {
        "en": "Heat level"
      },
      "values": [
        { "id": "0", "title": { "en": "Off" } },
        { "id": "1", "title": { "en": "Low" } },
        { "id": "2", "title": { "en": "Medium" } },
        { "id": "3", "title": { "en": "High" } }
      ]
    }
  ]
}
