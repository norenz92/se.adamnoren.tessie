{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.adamnoren.tessie",
  "version": "1.0.4",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Tessie"
  },
  "brandColor": "#333333",
  "description": {
    "en": "Adds support for Tesla via Tessie"
  },
  "tags": {
    "en": [
      "Tesla",
      "Tessie"
    ]
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Adam Norén"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "adamnorenverisure"
      },
      "githubSponsors": {
        "username": "norenz92"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/norenz92/se.adamnoren.tessie/issues"
  },
  "homepage": "https://share.tessie.com/1oPgpu3hfMb",
  "flow": {
    "actions": [
      {
        "id": "start_charging",
        "title": "Start Charging",
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=car"
          }
        ]
      },
      {
        "id": "stop_charging",
        "title": "Stop Charging",
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=car"
          }
        ]
      },
      {
        "id": "set_charge_current_request",
        "title": "Set Charging Current",
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=car"
          },
          {
            "name": "amps",
            "type": "number",
            "min": 0,
            "max": 16,
            "step": 1,
            "title": "Charging Current (A)",
            "titleFormatted": "Set Charging Current to [[amps]]A",
            "placeholder": "0A-16A"
          }
        ]
      },
      {
        "id": "start_climate",
        "title": "Start Climate",
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=car"
          },
          {
            "name": "climate_temperature",
            "type": "number",
            "min": 15,
            "max": 28,
            "step": 1,
            "title": "Temperature",
            "titleFormatted": "Start Climate at [[climate_temperature]]°C",
            "placeholder": "15°C-28°C",
            "required": false
          }
        ]
      },
      {
        "id": "stop_climate",
        "title": "Stop Climate",
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=car"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Car"
      },
      "class": "other",
      "capabilities": [],
      "platforms": [
        "local"
      ],
      "connectivity": [],
      "images": {
        "small": "/drivers/car/assets/images/small.png",
        "large": "/drivers/car/assets/images/large.png",
        "xlarge": "/drivers/car/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "accessToken"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "car",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Units"
          },
          "children": [
            {
              "id": "distance_format",
              "type": "label",
              "label": {
                "en": "Distance format"
              },
              "highlight": true
            },
            {
              "id": "temperature_format",
              "type": "label",
              "label": {
                "en": "Temperature format"
              },
              "highlight": true
            }
          ]
        }
      ]
    }
  ],
  "capabilities": {
    "climate_control": {
      "type": "boolean",
      "uiComponent": "toggle",
      "setable": true,
      "getable": true,
      "title": "Climate Control",
      "icon": "/drivers/car/assets/thermometer-half.svg"
    },
    "measure_battery": {
      "type": "number",
      "uiComponent": "battery",
      "title": "Battery Level",
      "insights": true,
      "getable": true,
      "setable": false,
      "icon": "/assets/icon.svg"
    },
    "measure_battery_range": {
      "type": "number",
      "uiComponent": "sensor",
      "title": "Estimated Range",
      "insights": true,
      "getable": true,
      "setable": false,
      "icon": "/drivers/car/assets/geo-fill.svg"
    },
    "measure_charge_current_request": {
      "type": "number",
      "uiComponent": "sensor",
      "title": "Current Charging Amps",
      "insights": true,
      "getable": true,
      "setable": true,
      "icon": "/drivers/car/assets/battery-charging.svg",
      "units": "A"
    },
    "measure_charging": {
      "type": "boolean",
      "uiComponent": "button",
      "setable": true,
      "getable": true,
      "title": "Charging",
      "icon": "/drivers/car/assets/battery-charging.svg"
    },
    "measure_est_battery_range": {
      "type": "number",
      "uiComponent": "sensor",
      "title": "Estimated Range",
      "insights": true,
      "getable": true,
      "setable": false,
      "icon": "/drivers/car/assets/geo-fill.svg"
    },
    "measure_minutes_to_full_charge": {
      "type": "number",
      "uiComponent": "sensor",
      "title": "Minutes to Full Charge",
      "insights": true,
      "getable": true,
      "setable": false,
      "icon": "/drivers/car/assets/hourglass-split.svg",
      "units": "minutes"
    },
    "measure_temperature_inside": {
      "type": "number",
      "uiComponent": "sensor",
      "title": "Inside Temperature",
      "insights": true,
      "getable": true,
      "setable": false,
      "icon": "/drivers/car/assets/thermometer-half.svg"
    },
    "measure_temperature_outside": {
      "type": "number",
      "uiComponent": "sensor",
      "title": "Outside Temperature",
      "insights": true,
      "getable": true,
      "setable": false,
      "icon": "/drivers/car/assets/thermometer-half.svg"
    }
  }
}