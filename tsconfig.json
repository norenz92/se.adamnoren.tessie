{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "homey": ["node_modules/homey-apps-sdk-v3-types"]
    },
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "homey-apps-sdk-v3-types"]
  },
  "include": ["app.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
